# 新服务器资料。只填数据，不填 shell 命令；不要在此保存密码。
# 必填：新服务器 SSH 地址。Windows 双击时留空会提示输入。
SSH_HOST=
SSH_PORT=22
SSH_USER=root
# 可选：SSH 密钥文件路径。相对路径按本资料文件夹解析。
SSH_IDENTITY_FILE=

# WireGuard 公网接入地址，留空时 Windows 入口自动使用 SSH_HOST。
# 云服务器使用私网网卡时，这里仍填写公网 IP 或域名。
ENDPOINT=
WG_PORT=51820
VPN_SUBNET=10.66.66.0/24
DNS=1.1.1.1,9.9.9.9
MTU=1420
WAN_INTERFACE=auto
